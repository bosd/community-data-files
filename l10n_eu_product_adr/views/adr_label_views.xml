<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="adr_label_view_form" model="ir.ui.view">
        <field name="model">adr.label</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="code" />
                        <field name="name" />
                        <field name="image" widget="image" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="adr_label_kanban_form" model="ir.ui.view">
        <field name="model">adr.label</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="id" />
                <templates>
                    <t t-name="card" class="flex-row align-items-center">
                        <aside class="me-3" t-if="record.image.raw_value">
                            <field
                                name="image"
                                widget="image"
                                options="{'img_class': 'o_image_64_contain'}"
                            />
                        </aside>
                        <main class="overflow-hidden">
                            <field name="code" class="fw-bold" />
                            <field name="name" class="text-wrap" />
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="adr_label_view_search" model="ir.ui.view">
        <field name="model">adr.label</field>
        <field name="arch" type="xml">
            <search>
                <field name="code" />
                <field name="name" />
            </search>
        </field>
    </record>
    <record id="adr_label_action" model="ir.actions.act_window">
        <field name="name">Dangerous Goods Labels</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">adr.label</field>
        <field name="view_mode">kanban,form</field>
    </record>
</odoo>
